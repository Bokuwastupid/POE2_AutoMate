                    </Grid>

                    <Grid Name="SettingsView" Visibility="Collapsed">
                        <StackPanel Margin="28" Width="520" HorizontalAlignment="Left">
                            <TextBlock Text="Settings" Style="{StaticResource TitleText}"/>
                            <TextBlock Text="Configuration file is created on first launch." Style="{StaticResource MutedText}" Margin="0,6,0,22"/>
                            <TextBlock Text="Settings path"/>
                            <TextBox Name="SettingsPathBox" Style="{StaticResource DarkTextBox}" IsReadOnly="True" Margin="0,6,0,18"/>
                            <Button Content="Reload Settings" Style="{StaticResource DarkButton}" Click="ReloadSettingsClick" Width="150" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
